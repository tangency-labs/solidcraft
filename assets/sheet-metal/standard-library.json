{
  "format": "solidcraft-sheet-rules",
  "version": 1,
  "name": "SolidCraft standard materials and gauges",
  "note": "Generic engineering values for a first part. Your shop's press brake, tooling and stock decide the real K-factor and inside radius: ask them, or import their rule pack.",
  "sources": [
    {
      "id": "msg",
      "title": "Manufacturers' Standard Gauge for sheet steel: thickness = weight (lb/ft²) / 41.82, rounded to 0.0001 in, as published gauge tables list it",
      "url": "https://en.wikipedia.org/wiki/Sheet_metal#Gauge"
    },
    {
      "id": "uss",
      "title": "United States Standard Gauge for sheet and plate iron and steel, 15 U.S.C. 206 (Act of March 3, 1893); stainless sheet is gauged by it (for example Protocase's bend chart: 304 16 ga 0.063 in, 14 ga 0.078 in)",
      "url": "https://www.law.cornell.edu/uscode/text/15/206"
    },
    {
      "id": "awg",
      "title": "Brown & Sharpe (American Wire Gauge), ASTM B258: d = 0.005 in × 92^((36 − n) / 39), rounded to 0.0001 in; the gauge for aluminium, copper and brass sheet",
      "url": "https://en.wikipedia.org/wiki/American_wire_gauge"
    },
    {
      "id": "kfactor",
      "title": "Generic air-bending K-factor chart: inside radius 0 to T: 0.33 soft (aluminium), 0.38 medium (steel), 0.40 hard (stainless); T to 3T: 0.40, 0.43, 0.45; over 3T: 0.50. Copper and brass are read as soft. Reproduced in METU MECH 114, Sheet Metal Work",
      "url": "https://users.metu.edu.tr/sonmez/MECH%20114/Sheet%20Metal%20Work.pdf"
    },
    {
      "id": "al-radii",
      "title": "Approximate minimum radius for 90° cold bend, by alloy, temper and thickness (the chart in Aircraft Spruce's aluminium catalog page): the upper end of the range for the next listed thickness at or above the sheet, and never under 1T",
      "url": "https://www.aircraftspruce.com/pdf/2026Individual/Cat26041.pdf"
    },
    {
      "id": "radius-1t",
      "title": "Inside radius of one thickness, as SolidCraft's default rule has it: Protocase's published radii for cold-rolled steel and 304 at 14 to 20 gauge are at or under 1T, so shops form it in these gauges. Ask yours for copper and brass",
      "url": "https://www.protocase.com/resources/Protocase-Bend-Radii-Bend-Sizes.pdf"
    }
  ],
