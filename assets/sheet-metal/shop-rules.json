                {
                  "url": "https://www.pcbway.com/rapid-prototyping/Sheet-metal/sheet-cutting.html",
                  "read": "2026-11-25",
                  "says": "laser holes at least 0.5 times the thickness (capability table), at least 50% of the thickness in the guide"
                },
                {
                  "url": "https://sendcutsend.com/guidelines/sheet-cutting/",
                  "read": "2026-11-25",
                  "says": "laser holes and cut-outs at least 50% of the material thickness; the exact figure per material is on each material page"
                },
                {
                  "url": "https://jlccnc.com/help/article/sheet-metal-fabrication-guidelines",
                  "read": "2026-11-25",
                  "says": "cutting holes at least half the sheet thickness"
                }
              ]
            },
            {
              "value": 1.0,
              "sources": [
                {
                  "url": "https://jlccnc.com/help/article/sheet-metal-fabrication-guidelines",
                  "read": "2026-11-25",
                  "says": "cutting holes also at least 1 mm across, whatever the thickness"
                }
              ]
            }
