          "id": "file.one_body",
          "sources": [
            {
              "url": "https://www.pcbway.com/rapid-prototyping/Sheet-metal/sheet-cutting.html",
              "read": "2026-11-25",
              "says": "each STEP file holds exactly one solid sheet-metal body; multi-body solids and assemblies are not processed in one part file"
            },
            {
              "url": "https://sendcutsend.com/guidelines/sheet-cutting/",
              "read": "2026-11-25",
              "says": "the STEP file holds a single solid sheet-metal body; files with several bodies or assemblies do not upload"
            }
