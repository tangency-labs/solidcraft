            {
              "url": "https://jlccnc.com/help/article/sheet-metal-fabrication-file-requirements",
              "read": "2026-11-25",
              "says": "for a part bent in one piece, every feature is modelled at the same sheet thickness; thicknesses are the listed stock"
            },
            {
              "url": "https://sendcutsend.com/guidelines/sheet-cutting/",
              "read": "2026-11-25",
              "says": "thickness is uniform, with a face at every edge, and modelled at the stock thickness that will be ordered"
            }
          ]
        },
        {
          "id": "hole.min_diameter",
          "unit": "mm",
