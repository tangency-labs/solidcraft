    {
      "id": "tab_fade_ms",
      "type": "range",
      "default": 240
    },
    {
      "id": "contrast",
      "type": "choice",
      "default": "soft",
      "label": {
        "en": "Contrast",
        "de": "Kontrast",
        "ja": "コントラスト",
        "ko": "대비",
        "zh": "对比度"
      },
      "help": {
        "en": "Soft stone layers or stronger separation between panels and fields.",
        "de": "Weiche Steinschichten oder stärkere Trennung von Flächen und Feldern.",
        "ja": "柔らかな石の階調か、パネルと入力欄を明確に分ける階調を選びます。",
        "ko": "부드러운 석재 톤 또는 패널과 입력란을 더 뚜렷하게 구분합니다.",
        "zh": "选择柔和的石色层次，或增强面板与输入框的区分。"
      },
      "values": [
        {
          "id": "soft",
          "label": {
            "en": "Soft",
            "de": "Weich",
            "ja": "ソフト",
            "ko": "부드럽게",
            "zh": "柔和"
          }
        },
        {
          "id": "defined",
          "label": {
            "en": "Defined",
            "de": "Deutlich",
            "ja": "くっきり",
            "ko": "뚜렷하게",
            "zh": "分明"
          }
        }
      ]
    },
    {
      "id": "edge_finish",
      "type": "choice",
      "default": "etched",
      "label": {
        "en": "Edge finish",
        "de": "Kanten",
        "ja": "縁の仕上げ",
        "ko": "가장자리",
        "zh": "边缘质感"
      },
      "help": {
        "en": "Flat outlines, a fine etched inner line, or a subtle raised bevel.",
        "de": "Flache Konturen, eine feine innere Gravurlinie oder eine dezente erhöhte Fase.",
        "ja": "平らな輪郭、細い内側の線、控えめな立体的な縁から選びます。",
        "ko": "평평한 윤곽, 얇은 안쪽 선 또는 은은하게 솟은 모서리를 선택합니다.",
        "zh": "选择平面轮廓、细致的内刻线或轻微凸起的斜边。"
      },
      "values": [
        {
          "id": "flat",
          "label": {
            "en": "Flat",
            "de": "Flach",
            "ja": "フラット",
            "ko": "평면",
            "zh": "平面"
          }
        },
        {
          "id": "etched",
          "label": {
            "en": "Etched",
            "de": "Graviert",
            "ja": "刻み線",
            "ko": "새김",
            "zh": "内刻"
          }
        },
        {
          "id": "bevel",
          "label": {
            "en": "Soft bevel",
            "de": "Sanfte Fase",
            "ja": "柔らかな面取り",
            "ko": "부드러운 모서리",
            "zh": "柔和斜边"
          }
        }
      ]
    },
    {
      "id": "accent",
      "type": "choice",
      "default": "slate",
      "label": {
        "en": "Accent",
        "de": "Akzent",
        "ja": "アクセント",
        "ko": "강조색",
        "zh": "强调色"
      },
      "help": {
        "en": "Selection, highlights and Model controls; workspace and status colours keep their meaning.",
        "de": "Auswahl, Hervorhebungen und Modell-Steuerung; Arbeitsbereichs- und Statusfarben behalten ihre Bedeutung.",
        "ja": "選択・強調・モデルの操作色。ワークスペースや状態の色の意味は変えません。",
        "ko": "선택, 강조 및 모델 조작의 색상입니다. 작업 공간과 상태 색상의 의미는 유지됩니다.",
        "zh": "更改选择、高亮与模型控件的色调；工作空间和状态色保持原有含义。"
      },
      "values": [
        {
          "id": "slate",
          "label": {
            "en": "Slate blue",
            "de": "Schieferblau",
            "ja": "石板の青",
            "ko": "슬레이트 블루",
            "zh": "岩蓝"
          }
        },
        {
          "id": "silver",
          "label": {
            "en": "Silver",
            "de": "Silber",
            "ja": "シルバー",
            "ko": "은색",
            "zh": "银灰"
          }
        },
        {
          "id": "sage",
          "label": {
            "en": "Sage",
            "de": "Salbei",
            "ja": "セージ",
            "ko": "세이지",
            "zh": "鼠尾草绿"
          }
        }
      ]
    },
    {
      "id": "foreground_colours",
      "type": "choice",
      "default": "vibrant",
      "label": {
        "en": "Foreground colours",
        "de": "Vordergrundfarben",
        "ja": "前景の色",
        "ko": "전경 색상",
        "zh": "前景颜色"
      },
      "help": {
        "en": "Vibrant strengthens axes, icons and guides. Muted keeps the original quiet palette. Accent controls selection.",
        "de": "Leuchtend verstärkt Achsen, Symbole und Hilfen. Gedämpft behält die ruhige ursprüngliche Palette. Akzent steuert die Auswahl.",
        "ja": "鮮やかは軸・アイコン・作図ガイドを強調します。落ち着いた配色は元の控えめな色を保ちます。選択の色はアクセントで設定します。",
        "ko": "선명함은 축·아이콘·가이드를 강조합니다. 차분함은 기존의 은은한 팔레트를 유지합니다. 선택 색상은 강조색 설정을 따릅니다.",
        "zh": "鲜艳增强轴、图标和辅助线的色彩。柔和保留原有的沉静配色。选择颜色仍由强调色控制。"
      },
      "values": [
        {
          "id": "muted",
          "label": {
            "en": "Muted",
            "de": "Gedämpft",
            "ja": "落ち着いた",
            "ko": "차분함",
            "zh": "柔和"
          }
        },
        {
          "id": "vibrant",
          "label": {
            "en": "Vibrant",
            "de": "Leuchtend",
            "ja": "鮮やか",
            "ko": "선명함",
            "zh": "鲜艳"
          }
        }
      ]
    }
  ],
