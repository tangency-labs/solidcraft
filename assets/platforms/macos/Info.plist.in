<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1) and
     @SHORT_VERSION@ (numeric X.Y.Z). Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>SolidCraft</string>
  <key>CFBundleName</key>
  <string>SolidCraft</string>
  <key>CFBundleExecutable</key>
  <string>SolidCraft</string>
  <key>CFBundleIdentifier</key>
  <string>io.tangencylabs.solidcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>SolidCraftVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleIconFile</key>
  <string>SolidCraft</string>
  <key>CFBundleIconName</key>
  <string>SolidCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>SolidCraft design</string>
      <key>CFBundleTypeExtensions</key>
      <!-- solidcraft: designs saved before .sc; solvecraft: before the rename (compatibility
           shims, docs/compatibility.md). -->
      <array><string>sc</string><string>solidcraft</string><string>solvecraft</string></array>
      <key>LSItemContentTypes</key>
      <array><string>io.tangencylabs.solidcraft.design</string></array>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>STEP, IGES and mesh files</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>step</string><string>stp</string><string>igs</string><string>iges</string><string>3mf</string><string>stl</string></array>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
  </array>
  <!-- The design type: .sc, and the older .solidcraft and .solvecraft (docs/compatibility.md). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.tangencylabs.solidcraft.design</string>
      <key>UTTypeDescription</key>
      <string>SolidCraft design</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.content</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>sc</string><string>solidcraft</string><string>solvecraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-solidcraft</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
