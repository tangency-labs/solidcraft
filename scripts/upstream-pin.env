# The usd-brep (SMLib/SM_API) reference solidcore is ported from: read, never built.
# Single source of truth for the pin: site/build.py, harness/plan, harness/callgraph and
# the CI workflows (via .github/actions/upstream, which clones it for upstream/TestFiles)
# all read it. Plain KEY=VALUE lines: sourceable by sh, appendable to $GITHUB_ENV, parsed
# by Python.
UPSTREAM_REPO=https://github.com/NVIDIA-Omniverse/usd-brep
UPSTREAM_VERSION=1.0.1
UPSTREAM_COMMIT=3fd5b9548d19aa8c12c29bc9637a96d42a06f8a5
