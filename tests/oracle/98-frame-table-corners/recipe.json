{
 "id": "98-frame-table-corners",
 "name": "Table frame: mitred rails on four legs",
 "description": "A 600 x 400 frame of rails in 45 x 45 bar on XY and four legs of the same bar, 700 long, down from its corners; every line through its section's centre. Each corner is one three-member corner: the two rails mitred to each other and the leg ending flat under them, with a 2 mm weld gap.",
 "exercises": [
  "frame_member",
  "frame_corner",
  "mitre_joint",
  "corner_post"
 ],
 "units": {
  "length": "mm",
  "angle": "deg",
  "area": "mm2",
  "volume": "mm3"
 },
 "conventions": {
  "world": "right-handed; Z up. XY/XZ/YZ are the origin planes.",
  "sketch_frame": "sketch-local 2D coords; world = plane.origin + x*plane.x_dir + y*plane.y_dir (origin in mm).",
  "members": "frame_member lays one bar per sketch line, its section centred on the line and square to it; bodies are named after body_name, numbered on (Rail, Rail (2), ...) in sketch and line order.",
  "corners": "frame_corner cuts its first two members where their middle lines meet on the plane halfway between them, each cut face gap / 2 back from that plane; a third member (a post) ends on the plane parallel to the first two, at the far side of their sections from it, gap back from it."
 },
