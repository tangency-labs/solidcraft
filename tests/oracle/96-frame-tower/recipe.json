{
 "id": "96-frame-tower",
 "name": "T-slot tower of butted frame members",
 "description": "The acceptance tower of #4003 in 45 x 45 bar: 600 x 600 footprint, 1500 high; 4 uprights at the corners, three rings of 4 rails butted between the uprights, flush with the outside, and 2 cross members in the middle ring butted between its rails along X. Every line runs through its section's centre, 22.5 in from the outside.",
 "exercises": [
  "frame_member",
  "frame_trim",
  "butt_joint"
 ],
 "units": {
  "length": "mm",
  "angle": "deg",
  "area": "mm2",
  "volume": "mm3"
 },
 "conventions": {
  "world": "right-handed; Z up. XY/XZ/YZ are the origin planes.",
  "sketch_frame": "sketch-local 2D coords; world = plane.origin + x*plane.x_dir + y*plane.y_dir (origin in mm).",
  "members": "frame_member lays one bar per sketch line, its section centred on the line and square to it; bodies are named after body_name, numbered on (Rail, Rail (2), ...) in sketch and line order.",
  "trims": "frame_trim butts each listed member's end against the side of the target member it meets (the nearer end, no gap)."
 },
