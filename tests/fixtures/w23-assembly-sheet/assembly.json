{
 "description": "W23 assembly sheet (#11773, part of #4894): a small test assembly whose parts list is counted by hand. A base plate BP-100 (120 x 80 x 10 mm) placed once; a screw SC-M6 (Ø6 x 20 mm) placed four times on the plate's corners; a holder HL-300, an assembly placed twice (the second 40 mm along Y), each holding one block BL-200 (20 x 20 x 30 mm) and two of the same screws. Parts only: BL-200 2, BP-100 1, SC-M6 8 (4 + 2 x 2). A step's `as` names the occurrence its reply returns, for the tests that read this script.",
 "commands": [
  {"command": "component.create", "params": {"name": "BasePlate"}, "as": "plate"},
  {"command": "solid.box", "params": {"length": 120, "width": 80, "height": 10, "body_name": "Plate"}},
  {"command": "component.activate", "params": {"component": 0}},
  {"command": "component.create", "params": {"name": "Screw"}, "as": "screw"},
  {"command": "solid.cylinder", "params": {"diameter": 6, "height": 20, "base": [5, 5, 10]}},
  {"command": "component.activate", "params": {"component": 0}},
  {"command": "occurrence.copy", "params": {"component": "Screw", "translate": [100, 0, 0]}},
  {"command": "occurrence.copy", "params": {"component": "Screw", "translate": [0, 60, 0]}},
  {"command": "occurrence.copy", "params": {"component": "Screw", "translate": [100, 60, 0]}},
  {"command": "component.create", "params": {"name": "Holder", "activate": false}, "as": "first_holder"},
  {"command": "component.create", "params": {"name": "Block", "parent": "Holder"}, "as": "block"},
  {"command": "solid.box", "params": {"length": 20, "width": 20, "height": 30, "corner": [40, 10, 10], "body_name": "Block"}},
  {"command": "component.activate", "params": {"component": 0}},
  {"command": "occurrence.copy", "params": {"component": "Screw", "parent": "Holder", "translate": [30, 0, 0]}},
  {"command": "occurrence.copy", "params": {"component": "Screw", "parent": "Holder", "translate": [30, 20, 0]}},
  {"command": "occurrence.copy", "params": {"component": "Holder", "translate": [0, 40, 0]}, "as": "second_holder"},
  {"command": "component.metadata.set", "params": {"component": "BasePlate", "part_number": "BP-100", "description": "Base plate 120 x 80 x 10"}},
  {"command": "component.metadata.set", "params": {"component": "Screw", "part_number": "SC-M6", "description": "Screw M6 x 20"}},
  {"command": "component.metadata.set", "params": {"component": "Holder", "part_number": "HL-300", "description": "Holder"}},
  {"command": "component.metadata.set", "params": {"component": "Block", "part_number": "BL-200", "description": "Block 20 x 20 x 30"}}
 ]
}
