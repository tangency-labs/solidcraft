[
 {
  "note": "solid.move moves bodies. Starting it while a sketch is being edited finishes the sketch first, as starting any other tool does, and then opens Move."
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "solid.box",
   "params": {
    "length": 20,
    "width": 20,
    "height": 20
   }
  }
 },
 {
  "call": "ui.view",
  "params": {
   "view": "iso"
  }
 },
 {
  "note": "With no sketch open it works as before: the window opens on a picked body."
 },
 {
  "start": "solid.move"
 },
 {
  "click": {
   "world": [
    10,
    10,
    20
   ]
  }
 },
 {
  "expect": {
   "dialog": "Move",
   "bodies": 1
  }
 },
 {
  "key": "Escape"
 },
 {
  "expect": {
   "dialog": null
  }
 },
 {
  "note": "Inside a sketch the same press finishes the sketch and opens Move."
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "sketch.create",
   "params": {
    "plane": "XZ"
   }
  }
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "sketch.rectangle.two_point",
   "params": {
    "p0": [
     40,
     0
    ],
    "p1": [
     80,
     20
    ]
   }
  }
 },
 {
  "expect": {
   "sketching": true,
   "sketch_curves": {
    "own": 4
   }
  }
 },
 {
  "start": "solid.move"
 },
 {
  "expect": {
   "dialog": "Move",
   "sketching": false
  }
 },
 {
  "note": "The sketch is finished with its four lines kept, and the body is where it was."
 },
 {
  "expect": {
   "sketching": false,
   "bodies": 1,
   "errors": 0
  }
 },
 {
  "expect": {
   "bbox": {
    "body": "Body1",
    "min": [
     0,
     0,
     0
    ],
    "max": [
     20,
     20,
     20
    ]
   }
  }
 },
 {
  "note": "Cancel the window and Move is still there to use, with the body still where it was."
 },
 {
  "key": "Escape"
 },
 {
  "expect": {
   "dialog": null,
   "sketching": false
  }
 },
 {
  "start": "solid.move"
 },
 {
  "click": {
   "world": [
    10,
    10,
    20
   ]
  }
 },
 {
  "expect": {
   "dialog": "Move"
  }
 },
 {
  "key": "Escape"
 },
 {
  "expect": {
   "dialog": null,
   "bodies": 1,
   "errors": 0
  }
 },
 {
  "expect": {
   "bbox": {
    "body": "Body1",
    "min": [
     0,
     0,
     0
    ],
    "max": [
     20,
     20,
     20
    ]
   }
  }
 },
 {
  "shot": "move_disabled_in_sketch"
 }
]
