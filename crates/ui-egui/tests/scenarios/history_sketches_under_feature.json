[
  {"note": "History › Sketches: Under their feature lists a sketch under the feature built from it (#6489). Model: Sketch1 → Extrude1, Sketch2 → Cut1, and Sketch3 used by Boss1 and Hole1 (one circle each). The History sits under the browser."},
  {"call": "ui.prefs", "params": {"timeline_left": true, "timeline_under_browser": true}},
  {"call": "engine.execute", "params": {"command": "sketch.create", "params": {"plane": "XY", "name": "Sketch1"}}},
  {"call": "engine.execute", "params": {"command": "sketch.rectangle.two_point", "params": {"p0": [0, 0], "p1": [40, 30]}}},
  {"call": "engine.execute", "params": {"command": "sketch.finish", "params": {}}},
  {"call": "engine.execute", "params": {"command": "solid.extrude", "params": {"sketch": "Sketch1", "distance": 10, "operation": "new", "name": "Extrude1"}}},
  {"call": "engine.execute", "params": {"command": "sketch.create", "params": {"plane": "XY", "name": "Sketch2"}}},
  {"call": "engine.execute", "params": {"command": "sketch.rectangle.two_point", "params": {"p0": [15, 10], "p1": [25, 20]}}},
  {"call": "engine.execute", "params": {"command": "sketch.finish", "params": {}}},
  {"call": "engine.execute", "params": {"command": "solid.extrude", "params": {"sketch": "Sketch2", "through_all": true, "operation": "cut", "name": "Cut1"}}},
  {"call": "engine.execute", "params": {"command": "sketch.create", "params": {"plane": "XY", "name": "Sketch3"}}},
  {"call": "engine.execute", "params": {"command": "sketch.circle.center", "params": {"center": [7, 7], "radius": 3}}},
  {"call": "engine.execute", "params": {"command": "sketch.circle.center", "params": {"center": [33, 23], "radius": 3}}},
  {"call": "engine.execute", "params": {"command": "sketch.finish", "params": {}}},
  {"call": "engine.execute", "params": {"command": "solid.extrude", "params": {"sketch": "Sketch3", "profiles": [{"point": [7, 7]}], "distance": 18, "operation": "join", "name": "Boss1"}}},
  {"call": "engine.execute", "params": {"command": "solid.extrude", "params": {"sketch": "Sketch3", "profiles": [{"point": [33, 23]}], "through_all": true, "operation": "cut", "name": "Hole1"}}},
  {"expect": {"bodies": 1, "errors": 0}},
  {"note": "In order (the default): every sketch is a row of its own and nothing folds."},
  {"expect": {"prefs": {"history_sketches": "in_order"}, "shown_handles": ["timeline:Sketch1", "timeline:Extrude1", "timeline:Sketch2", "timeline:Cut1", "timeline:Sketch3", "timeline:Boss1", "timeline:Hole1"], "hidden_handles": ["timeline-sketches-fold:Extrude1", "timeline-sketches-fold:Boss1"]}},
  {"note": "Preferences › Interface › Sketches: Under their feature. Each sketch folds under its feature; the folds start closed."},
  {"call": "ui.prefs", "params": {"open": "Interface"}},
  {"widget": "Under their feature"},
  {"widget": "OK"},
  {"expect": {"prefs": {"dialog": null, "history_sketches": "under_feature"}, "shown_handles": ["timeline:Extrude1", "timeline-sketches-fold:Extrude1", "timeline:Cut1", "timeline-sketches-fold:Cut1", "timeline:Boss1", "timeline-sketches-fold:Boss1", "timeline:Hole1", "timeline-sketches-fold:Hole1"], "hidden_handles": ["timeline:Sketch1", "timeline:Sketch2", "timeline:Sketch3"]}},
  {"note": "Sketch3 is listed under Boss1, its first feature; Hole1 shows a row that selects the same sketch."},
  {"click": {"handle": "timeline-sketches-fold:Boss1"}},
  {"click": {"handle": "timeline-sketches-fold:Hole1"}},
  {"expect": {"shown_handles": ["timeline:Sketch3", "timeline-reference:Hole1:Sketch3"], "hidden_handles": ["timeline:Sketch1", "timeline:Sketch2"]}},
  {"click": {"handle": "timeline-reference:Hole1:Sketch3"}},
  {"expect": {"selection": 1}},
  {"note": "With the marker between Sketch3 and Boss1 the sketch exists and its features don't: it has a row of its own above the marker."},
  {"call": "engine.execute", "params": {"command": "timeline.roll_to", "params": {"feature": "Sketch3"}}},
  {"expect": {"shown_handles": ["timeline:Sketch3", "timeline:rollback", "timeline:Boss1", "timeline:Hole1"], "hidden_handles": ["timeline-sketches-fold:Boss1", "timeline-sketches-fold:Hole1", "timeline-reference:Hole1:Sketch3"]}},
  {"call": "engine.execute", "params": {"command": "timeline.roll_to", "params": {}}},
  {"expect": {"shown_handles": ["timeline-sketches-fold:Boss1", "timeline:Sketch3"], "errors": 0}},
  {"note": "Back to In order: the rows are the timeline's again."},
  {"call": "ui.prefs", "params": {"history_sketches": "in_order"}},
  {"expect": {"shown_handles": ["timeline:Sketch1", "timeline:Sketch2", "timeline:Sketch3"], "hidden_handles": ["timeline-sketches-fold:Boss1", "timeline-reference:Hole1:Sketch3"]}}
]
