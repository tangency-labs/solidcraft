[
  {"note": "Interface › Status bar (#7243): a thin bar along the window's bottom edge, off by default."},
  {"expect": {"hidden_handles": ["status:bar", "status:units", "status:sketch", "status:editing"]}},
  {"call": "ui.prefs", "params": {"status_bar": true}},
  {"frames": 2},
  {"note": "Idle: only the design's units."},
  {"expect": {"shown_handles": ["status:bar", "status:units"], "hidden_handles": ["status:sketch", "status:editing"]}},
  {"start": "sketch.create"},
  {"click": {"plane": "XY"}},
  {"start": "sketch.rectangle.two_point"},
  {"click": {"sketch": [0, 0]}},
  {"click": {"sketch": [40, 30]}},
  {"key": "Escape"},
  {"note": "In a sketch: what is being edited, the sketch's state, then the units, left to right."},
  {"expect": {"sketching": true, "handle_order": ["status:editing", "status:sketch", "status:units"]}},
  {"note": "A click on the units opens the Units menu; a row runs Change Design Units, one undo step."},
  {"click": {"handle": "status:units"}},
  {"frames": 2},
  {"call": "ui.menuPick", "params": {"item": "in"}},
  {"expect": {"query": {"command": "document.inspect", "path": ["units"], "value": "in"}, "sketching": true, "errors": 0}},
  {"call": "engine.execute", "params": {"command": "edit.undo", "params": {}}},
  {"expect": {"query": {"command": "document.inspect", "path": ["units"], "value": "mm"}}},
  {"call": "engine.execute", "params": {"command": "sketch.finish", "params": {}}},
  {"expect": {"sketching": false, "shown_handles": ["status:units"], "hidden_handles": ["status:sketch", "status:editing"]}},
  {"note": "Turned off again, the bar goes."},
  {"call": "ui.prefs", "params": {"status_bar": false}},
  {"frames": 2},
  {"expect": {"hidden_handles": ["status:bar", "status:units", "status:sketch", "status:editing"]}}
]
