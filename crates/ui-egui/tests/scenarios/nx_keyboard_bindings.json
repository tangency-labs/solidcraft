[
  {"note":"NX keyboard shortcuts explicitly opt in, use existing commands, and leave mouse navigation independent."},
  {"call":"engine.execute","params":{"command":"solid.box","params":{"length":20,"width":10,"height":5}}},
  {"call":"ui.prefs","params":{"open":"Navigation","nav":"nx","look_at_anim":false}},
  {"expect":{"prefs":{"nav":"nx","nx_shortcuts":false}}},
  {"click":{"handle":"prefs:nx_shortcuts"}},
  {"expect":{"prefs":{"nx_shortcuts":true}}},
  {"call":"ui.prefs","params":{"button":"ok"}},
  {"camera":{"yaw":0.12,"pitch":0.08}},
  {"key":"F8"},
  {"expect":{"camera":{"yaw_deg":0,"pitch_deg":0,"panned":false,"zoomed":"no"}}},
  {"call":"engine.execute","params":{"command":"select.set","params":{"items":[{"type":"body","name":"Body1"}]}}},
  {"key":"W","cmd":true},
  {"expect":{"hidden":["Body1"],"bodies":1,"errors":0}},
  {"key":"K","cmd":true,"shift":true},
  {"expect":{"hidden":[],"bodies":1,"errors":0}},
  {"call":"ui.prefs","params":{"nx_shortcuts":false}},
  {"camera":{"yaw":0.12,"pitch":0.08}},
  {"key":"F8"},
  {"expect":{"camera":{"yaw_deg":7,"pitch_deg":5,"panned":false,"zoomed":"no"},"errors":0}}
]
