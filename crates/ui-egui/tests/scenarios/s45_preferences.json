[
  {"note": "#36: one Preferences dialog, from the gear at the top right (and Ctrl+,). Changes apply at once; Cancel puts them back, OK keeps them."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"shown": "Restore page defaults", "prefs": {"dialog": "General", "theme": "dark", "dark": true}}},
  {"expect": {"shown": "Profiles"}},
  {"widget": "Reopen the designs that were open last time"},
  {"expect": {"prefs": {"reopen_designs": false}}},
  {"click": {"handle": "prefs:page:Appearance"}},
  {"click": {"handle": "prefs:theme"}},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "light", "dark": false}}},
  {"widget": "Cancel"},
  {"expect": {"not_shown": "Restore page defaults", "prefs": {"dialog": null, "theme": "dark", "dark": true, "reopen_designs": true}}},
  {"note": "Ctrl+, opens it again; the shortcuts page is in the same dialog."},
  {"key": "Comma", "cmd": true},
  {"expect": {"prefs": {"dialog": "General"}}},
  {"click": {"handle": "prefs:page:Shortcuts"}},
  {"expect": {"shown": "Reset All", "prefs": {"dialog": "Shortcuts"}}},
  {"click": {"handle": "prefs:page:Navigation"}},
  {"widget": "Fusion"},
  {"widget": "Tinkercad"},
  {"expect": {"prefs": {"nav": "tinkercad"}}},
  {"click": {"handle": "prefs:page:Design"}},
  {"widget": "Y up"},
  {"expect": {"prefs": {"up_axis": "y", "dialog": "Design"}}},
  {"widget": "OK"},
  {"expect": {"not_shown": "Restore page defaults", "prefs": {"up_axis": "y", "dialog": null}}}
]
