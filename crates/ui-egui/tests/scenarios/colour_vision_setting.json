[
  {"note": "Colour vision lives on Appearance: choices apply immediately; Cancel restores them, OK keeps them, and Appearance defaults reset them. Use English for exact captions. Page scrolling preserves the fixed window width."},
  {"call": "ui.prefs", "params": {"language": "en"}},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"prefs": {"dialog": "General", "color_vision": "off"}, "same_width": "prefs:window"}},
  {"click": {"handle": "prefs:page:Appearance"}},
  {"call": "ui.scroll", "params": {"x": 1000, "y": 500, "delta": -5000}},
  {"call": "ui.inspect", "params": {}},
  {"expect": {"shown": "Color vision", "prefs": {"dialog": "Appearance"}, "same_width": "prefs:window"}},
  {"click": {"handle": "prefs:color_vision:protan"}},
  {"expect": {"prefs": {"color_vision": "protan"}}},
  {"click": {"handle": "prefs:color_vision:deutan"}},
  {"expect": {"prefs": {"color_vision": "deutan"}, "same_width": "prefs:window"}},
  {"widget": "Cancel"},
  {"expect": {"prefs": {"dialog": null, "color_vision": "off"}}},
  {"key": "Comma", "cmd": true},
  {"click": {"handle": "prefs:page:Appearance"}},
  {"call": "ui.scroll", "params": {"x": 1000, "y": 500, "delta": -5000}},
  {"call": "ui.inspect", "params": {}},
  {"click": {"handle": "prefs:color_vision:tritan"}},
  {"widget": "OK"},
  {"expect": {"prefs": {"dialog": null, "color_vision": "tritan"}}},
  {"key": "Comma", "cmd": true},
  {"click": {"handle": "prefs:page:Appearance"}},
  {"call": "ui.scroll", "params": {"x": 1000, "y": 500, "delta": -5000}},
  {"call": "ui.inspect", "params": {}},
  {"expect": {"shown": "Tritan", "same_width": "prefs:window"}},
  {"widget": "Restore page defaults"},
  {"expect": {"prefs": {"color_vision": "off"}}},
  {"widget": "OK"},
  {"expect": {"prefs": {"dialog": null, "color_vision": "off"}}}
]
