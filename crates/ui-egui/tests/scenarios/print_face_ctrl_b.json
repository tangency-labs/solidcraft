[
  {"note":"#8429, with print_face_everywhere (the old behaviour kept behind a preference): Ctrl+B marks the one selected flat face as its body's print face, the design saves it, and Ctrl+B on it again clears it. Without a face selected it says what to select."},
  {"call":"ui.prefs","params":{"print_face_everywhere":true}},
  {"call":"engine.execute","params":{"command":"solid.box","params":{"length":20,"width":10,"height":5,"body_name":"Block"}}},
  {"call":"ui.camera","params":{"target":[10,5,2.5],"yaw":-0.785398,"pitch":0.61548,"distance":70}},
  {"key":"B","ctrl":true},
  {"expect":{"status":"Select one flat face","errors":0}},
  {"click":{"world":[20,5,2.5]}},
  {"expect":{"selection":1}},
  {"key":"B","ctrl":true},
  {"expect":{"status":"Block: print face set","errors":0}},
  {"shot":"print_face_ctrl_b"},
  {"call":"engine.execute","params":{"command":"file.save_as","params":{"path":"$DIR/print-face.json"}}},
  {"expect":{"file_contains":{"file":"print-face.json","text":"\"print_faces\""}}},
  {"key":"B","ctrl":true},
  {"expect":{"status":"Block: print face cleared","errors":0}}
]
