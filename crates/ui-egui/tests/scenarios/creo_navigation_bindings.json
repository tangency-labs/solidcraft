[
  {"note": "Creo navigation: choose the preset in Preferences, then orbit, pan and zoom using the middle button. Other presets keep their drag zoom direction."},
  {"call": "engine.execute", "params": {"command": "solid.box", "params": {"length": 20, "width": 10, "height": 5}}},
  {"call": "ui.prefs", "params": {"open": "Navigation"}},
  {"click": {"handle": "dialog:Pan, zoom, orbit"}},
  {"widget": "Creo"},
  {"expect": {"prefs": {"nav": "creo"}}},
  {"call": "ui.prefs", "params": {"button": "ok"}},
  {"call": "ui.prefs", "params": {"orbit_around": "view_centre", "zoom_to_cursor": false, "free_orbit": false}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 848, "y1": 500, "steps": 8, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 22, "pitch_deg": 0, "panned": false, "zoomed": "no"}, "selection": 0}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 860, "y1": 540, "steps": 8, "shift": true, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": true, "zoomed": "no"}}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 800, "y1": 560, "steps": 8, "ctrl": true, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "in"}}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 800, "y1": 440, "steps": 8, "ctrl": true, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "out"}}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 860, "y1": 540, "steps": 8, "button": "right"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "no"}, "selection": 0}},
  {"call": "ui.prefs", "params": {"nav": "blender"}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 800, "y1": 560, "steps": 8, "ctrl": true, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "out"}}}
]
