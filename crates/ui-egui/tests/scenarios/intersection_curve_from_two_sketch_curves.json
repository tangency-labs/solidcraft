  {"expect": {"query": {"command": "sketch.inspect", "path": ["wires", 0, "start", 2], "value": 5}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["wires", 0, "end", 1], "value": 0}}},
  {"expect": {"query": {"command": "sketch.inspect", "path": ["wires", 0, "end", 2], "value": 5}}},
