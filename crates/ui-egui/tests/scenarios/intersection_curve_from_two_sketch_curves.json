  {"click": {"world": [0, 10, 5]}},
  {"expect": {"sketch_curves": {"own": 1}}},
  {"key": "Escape"},
  {"start": "sketch.finish"},
  {"expect": {"errors": 0}},
  {"start": "sketch.create"},
