[
  {"note": "Alias preset (#304): Shift+Alt+left drag orbits, Shift+Alt+middle pans, Shift+Alt+right zooms (down: out, up: in). Other presets don't navigate with Shift+Alt+left."},
  {"call": "engine.execute", "params": {"command": "solid.box", "params": {"length": 20, "width": 10, "height": 5}}},
  {"call": "ui.prefs", "params": {"nav": "alias"}},
  {"note": "The orbit centre is its own preference: pin the view centre (the default) here. Every pivot moves the camera's target as the view turns, the view centre too (the middle of the view the panels leave free, #14651), so the orbit step checks the turn and the zoom; the pan and zoom steps check `panned`."},
  {"call": "ui.prefs", "params": {"orbit_around": "view_centre"}},
  {"expect": {"prefs": {"nav": "alias"}}},

  {"note": "Orbit: like a right drag (from the drag threshold on), and Shift (part of the binding) doesn't snap."},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 848, "y1": 500, "steps": 8, "shift": true, "alt": true}},
  {"expect": {"camera": {"yaw_deg": 19.25, "pitch_deg": 0, "zoomed": "no"}, "selection": 0}},

  {"note": "Pan."},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 860, "y1": 540, "steps": 8, "shift": true, "alt": true, "button": "middle"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": true, "zoomed": "no"}}},

  {"note": "Zoom (dolly): dragging down moves away, dragging up moves closer."},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 800, "y1": 560, "steps": 8, "shift": true, "alt": true, "button": "right"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "out"}, "dialog": null}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 800, "y1": 440, "steps": 8, "shift": true, "alt": true, "button": "right"}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "in"}}},

  {"note": "Fusion: Shift+Alt+left drag is not navigation."},
  {"call": "ui.prefs", "params": {"nav": "fusion"}},
  {"camera": {"yaw": 0, "pitch": 0}},
  {"call": "ui.drag", "params": {"x0": 800, "y0": 500, "x1": 848, "y1": 500, "steps": 8, "shift": true, "alt": true}},
  {"expect": {"camera": {"yaw_deg": 0, "pitch_deg": 0, "panned": false, "zoomed": "no"}}}
]
