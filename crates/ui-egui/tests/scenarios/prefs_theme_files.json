[
  {"note": "#2255: theme tiles offer the built-in themes; choosing one applies it immediately, and Cancel restores the previous theme."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"prefs": {"dialog": "General", "theme": "dark", "dark": true}}},
  {"widget": "Appearance"},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "light", "dark": false}, "shown_handles": ["prefs:theme"]}},
  {"click": {"handle": "prefs:theme:gruvbox-dark"}},
  {"expect": {"prefs": {"theme": "gruvbox-dark", "dark": true}}},
  {"click": {"handle": "prefs:theme:light"}},
  {"expect": {"prefs": {"theme": "light", "dark": false}}},
  {"widget": "Cancel"},
  {"expect": {"prefs": {"dialog": null, "theme": "dark", "dark": true}}},
  {"note":"Gruvbox has two cards, each with Soft, Standard and Hard contrast. Old variant ids select the matching choice."},
  {"call":"ui.prefs","params":{"theme":"gruvbox-dark-hard","open":"Interface"}},
  {"expect":{"prefs":{"theme":"gruvbox-dark","theme_option_values":{"contrast":"hard"}},"theme_colors":{"panel":"#1d2021"}}},
  {"call":"ui.prefs","params":{"theme_options":{"gruvbox-dark":{"contrast":"soft"}}}},
  {"expect":{"prefs":{"theme_option_values":{"contrast":"soft"}},"theme_colors":{"panel":"#32302f"}}},
  {"call":"ui.prefs","params":{"theme":"gruvbox-light-hard"}},
  {"expect":{"prefs":{"theme":"gruvbox-light","theme_option_values":{"contrast":"hard"}},"theme_colors":{"panel":"#f9f5d7"}}},
  {"call":"ui.prefs","params":{"theme":"gruvbox-dark"}},
  {"expect":{"prefs":{"theme_option_values":{"contrast":"soft"}},"theme_colors":{"panel":"#32302f"}}},
  {"call":"ui.prefs","params":{"theme_options":{"gruvbox-dark":{"contrast":null}}}},
  {"expect":{"prefs":{"theme_option_values":{"contrast":"standard"}},"theme_colors":{"panel":"#282828"}}},
  {"call":"ui.prefs","params":{"theme_options":{"gruvbox-light":{}}}},
  {"call":"ui.prefs","params":{"button":"ok"}},
  {"note": "Okibi (dark) and Akari (light) are built in by id."},
  {"call": "ui.prefs", "params": {"theme": "akari"}},
  {"expect": {"prefs": {"theme": "akari", "dark": false}}},
  {"call": "ui.prefs", "params": {"theme": "okibi"}},
  {"expect": {"prefs": {"theme": "okibi", "dark": true}}},
  {"note":"#9806: per-theme option overrides apply through ui.prefs and keep authored export defaults."},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Options","base":"dark","colors":{"panel":"#112233"},"options":[{"id":"enabled","type":"bool","default":false}],"overlays":[{"when":{"opt":"enabled","eq":true},"colors":{"panel":"#abcdef"}}]},"theme_options":{"scenario-options":{"enabled":true}}}},
  {"expect":{"prefs":{"theme":"scenario-options","theme_option_values":{"enabled":true},"theme_option_notices":[]},"theme_colors":{"panel":"#abcdef"}}},
  {"call":"ui.prefs","params":{"theme":"dark"}},
  {"expect":{"prefs":{"theme_option_values":{},"theme_option_notices":[]}}},
  {"call":"ui.prefs","params":{"theme":"scenario-options"}},
  {"expect":{"prefs":{"theme_option_values":{"enabled":true}},"theme_colors":{"panel":"#abcdef"}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-options":{"enabled":false,"unknown":true}},"ui_scale":1.5},"fail":true},
  {"expect":{"prefs":{"theme_option_values":{"enabled":true},"ui_scale":1.0},"theme_colors":{"panel":"#abcdef"}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-options":{"enabled":null}}}},
  {"expect":{"prefs":{"theme_option_values":{"enabled":false}},"theme_colors":{"panel":"#112233"}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-options":{"enabled":true}}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-options":{}}}},
  {"expect":{"prefs":{"theme_options":{},"theme_option_values":{"enabled":false}},"theme_colors":{"panel":"#112233"}}},
  {"note":"#9808: imported tab surfaces follow Model, Sketch and Render together; disabling them restores the exact base on every tab."},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Tabs","base":"dark","colors":{"panel":"#18202a","viewport_top":"#182430","viewport_bottom":"#29394a"},"options":[{"id":"tab_colours","type":"bool","default":true},{"id":"tab_fade_ms","type":"range","default":0}],"tabs":{"SKETCH":{"panel":"#123028","viewport_top":"#103128","viewport_bottom":"#204a3c"},"RENDER":{"panel":"#302039","viewport_top":"#30203d","viewport_bottom":"#493252"}}}}},
  {"call":"ui.set","params":{"tab":"MODEL"}},
  {"expect":{"theme_colors":{"panel":"#18202a","viewport_top":"#182430","viewport_bottom":"#29394a"}}},
  {"call":"engine.execute","params":{"command":"sketch.create","params":{"plane":"XY"}}},
  {"expect":{"theme_colors":{"panel":"#123028","viewport_top":"#103128","viewport_bottom":"#204a3c"}}},
  {"call":"engine.execute","params":{"command":"sketch.finish","params":{}}},
  {"call":"ui.workspace","params":{"workspace":"render"}},
  {"expect":{"theme_colors":{"panel":"#302039","viewport_top":"#30203d","viewport_bottom":"#493252"}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-tabs":{"tab_colours":false}}}},
  {"expect":{"theme_colors":{"panel":"#18202a","viewport_top":"#182430","viewport_bottom":"#29394a"}}},
  {"call":"ui.workspace","params":{"workspace":"design"}},
  {"call":"engine.execute","params":{"command":"sketch.create","params":{"plane":"XY"}}},
  {"expect":{"theme_colors":{"panel":"#18202a","viewport_top":"#182430","viewport_bottom":"#29394a"}}},
  {"call":"engine.execute","params":{"command":"sketch.finish","params":{}}},
  {"call":"ui.set","params":{"tab":"MODEL"}},
  {"expect":{"theme_colors":{"panel":"#18202a","viewport_top":"#182430","viewport_bottom":"#29394a"}}},
  {"note":"#9810: blur intent uses ui.prefs, survives unavailable evidence fixtures and stale definitions; injected fixtures do not claim real GPU/OS support."},
  {"call":"ui.resize","params":{"width":1600,"height":1100}},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Blur","base":"dark","options":[{"id":"opacity","type":"range","default":75},{"id":"blur","type":"range","default":0}]},"theme_options":{"scenario-tabs":{},"scenario-blur":{"blur":18.25}},"open":"Interface"}},
  {"expect":{"prefs":{"theme":"scenario-blur","theme_option_values":{"opacity":75.0,"blur":18.25},"theme_option_notices":[]},"shown_handles":["prefs:theme_option:blur"]}},
  {"call":"ui.blur","params":{"fixture":"gpu-software"}},
  {"frames":2},
  {"click":{"handle":"prefs:theme_option:blur"}},
  {"expect":{"prefs":{"theme_option_values":{"opacity":75.0,"blur":18.25},"theme_options":{"scenario-blur":{"blur":18.25}}}}},
  {"call":"ui.blur","params":{"fixture":"reduce-transparency"}},
  {"expect":{"prefs":{"theme_option_values":{"opacity":75.0,"blur":18.25}}}},
  {"call":"ui.blur","params":{"fixture":"clear"}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-blur":{"blur":60}}}},
  {"expect":{"prefs":{"theme_option_values":{"opacity":75.0,"blur":60.0}}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-blur":{"blur":18.25}}}},
  {"call":"ui.prefs","params":{"theme_options":{"scenario-blur":{"blur":61}},"ui_scale":1.5},"fail":true},
  {"expect":{"prefs":{"theme_option_values":{"opacity":75.0,"blur":18.25},"ui_scale":1.0}}},
  {"call":"ui.blur","params":{"fixture":"guard-60"}},
  {"frames":2},
  {"expect":{"shown_handles":["prefs:theme_notice_undo:guard"]}},
  {"click":{"handle":"prefs:theme_notice_undo:guard"}},
  {"expect":{"hidden_handles":["prefs:theme_notice_undo:guard"],"prefs":{"theme_option_values":{"opacity":75.0,"blur":18.25}}}},
  {"call":"ui.blur","params":{"fixture":"clear"}},
  {"note":"Reimporting the same identity without blur leaves the old raw override untouched and exposes a dismissible unknown-entry notice."},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Blur","base":"dark","options":[{"id":"opacity","type":"range","default":75}]}}},
  {"frames":2},
  {"expect":{"prefs":{"theme_options":{"scenario-blur":{"blur":18.25}},"theme_option_notices":[{"id":"blur","kind":"unknown_option"}]},"shown_handles":["prefs:theme_notice_dismiss:blur"]}},
  {"click":{"handle":"prefs:theme_notice_dismiss:blur"}},
  {"expect":{"hidden_handles":["prefs:theme_notice_dismiss:blur"],"prefs":{"theme_options":{"scenario-blur":{"blur":18.25}},"theme_option_notices":[{"id":"blur","kind":"unknown_option"}]}}},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Blur","base":"dark","options":[{"id":"blur","type":"range","default":0}]}}},
  {"expect":{"prefs":{"theme_option_values":{"blur":18.25},"theme_option_notices":[]}}},
  {"call":"ui.prefs","params":{"theme_import":{"format":"solidcraft-theme/1","name":"Scenario Future Blur","base":"dark","requires":2,"options":[{"id":"blur","type":"range","default":18}]}}},
  {"frames":2},
  {"expect":{"shown_handles":["prefs:theme_notice_dismiss:newer"],"prefs":{"theme_option_defs":[],"theme_option_values":{}}}},
  {"click":{"handle":"prefs:theme_notice_dismiss:newer"}},
  {"expect":{"hidden_handles":["prefs:theme_notice_dismiss:newer"],"prefs":{"theme_option_defs":[]}}},
  {"call":"ui.prefs","params":{"button":"ok","theme":"dark"}}
]
