[
  {"note": "Dialogs: In the left column (#6707). Extrude takes the browser's place at its width (never narrower than the card), the bottom History strip stays, and Cancel (or Enter, which applies it) brings the browser back as it was."},
  {"call": "ui.prefs", "params": {"dialog_place": "left_column"}},
  {"start": "sketch.create"},
  {"click": {"plane": "XY"}},
  {"start": "sketch.rectangle.two_point"},
  {"click": {"sketch": [0, 0]}},
  {"click": {"sketch": [40, 30]}},
  {"key": "Escape"},
  {"start": "sketch.finish"},
  {"expect": {"sketching": false, "same_width": "browser:card"}},
  {"start": "solid.extrude"},
  {"frames": 4},
  {"expect": {"dialog": "Extrude", "spans": {"inner": "dialog:outer", "outer": "dialog:column", "axis": "x", "tol": 3}}},
  {"expect": {"shown_handles": ["dialog:OK"]}},
  {"widget": "Cancel"},
  {"frames": 4},
  {"expect": {"dialog": null, "same_width": "browser:card"}},
  {"start": "solid.extrude"},
  {"text": "10"},
  {"key": "Enter"},
  {"frames": 4},
  {"expect": {"dialog": null, "bodies": 1, "same_width": "browser:card"}}
]
