[
  {"note": "With Preferences open and nothing being edited, typing focuses Search preferences and the letters are the query. Enter opens that setting on its own page."},
  {"click": {"handle": "titlebar:preferences"}},
  {"expect": {"shown": "Restore Defaults", "prefs": {"dialog": "General"}}},
  {"text": "zo"},
  {"frames": 3},
  {"expect": {"shown": "Reverse zoom direction", "not_shown": "Units of new designs"}},
  {"key": "Enter"},
  {"frames": 2},
  {"expect": {"shown": "Reverse zoom direction", "prefs": {"dialog": "Navigation"}}},
  {"call": "ui.prefs", "params": {"open": "General"}},
  {"text": "Direct interaction"},
  {"frames": 3},
  {"expect": {"shown": "Work > Tools"}},
  {"key": "Enter"},
  {"frames": 2},
  {"expect": {"shown": "Direct interaction", "prefs": {"dialog": "Tools"}}},
  {"key": "Escape"},
  {"expect": {"not_shown": "Restore Defaults", "prefs": {"dialog": null}}}
]
