  {
   "id": "save-selected-all-files",
   "rules": [
    "3.1",
    "3.1.2"
   ],
   "title": "Save Selected saves in row order without asking where, then everything closes",
   "docs": [
    {
     "id": "bracket",
     "name": "Bracket",
     "path": "~/Designs/Bracket.sc",
     "dirty": true
    },
    {
     "id": "lid",
     "name": "Lid",
     "path": "~/Designs/Lid.sc",
     "dirty": true
    },
    {
     "id": "gearbox",
     "name": "Gearbox",
     "path": "~/Designs/Gearbox.sc",
     "dirty": false
    }
   ],
   "steps": [
    {
     "do": "saveSelected"
    },
    {
     "expect": {
      "request": {
       "type": "save",
       "id": "bracket",
       "path": "~/Designs/Bracket.sc"
      },
      "rows": [
       {
        "id": "bracket",
        "state": "saving"
       },
       {
        "id": "lid",
        "state": "unsaved"
       }
      ]
     }
    },
    {
     "do": "saveDone"
    },
    {
     "expect": {
      "request": {
       "type": "save",
       "id": "lid"
      },
      "rows": [
       {
        "id": "bracket",
        "state": "saved"
       },
       {
        "id": "lid",
        "state": "saving"
       }
      ],
      "open": [
       "bracket",
       "lid",
       "gearbox"
      ]
     }
    },
    {
     "do": "saveDone"
    },
    {
     "expect": {
      "prompt": "none",
      "outcome": "proceeded",
      "open": [],
      "saved": {
       "bracket": "~/Designs/Bracket.sc",
       "lid": "~/Designs/Lid.sc"
      },
      "lost": []
     }
    }
   ]
  },
  {
   "id": "picker-only-for-never-saved",
   "rules": [
    "3.1"
   ],
   "title": "Save Selected asks where only for the never-saved document",
   "docs": [
    {
     "id": "bracket",
     "name": "Bracket",
     "path": "~/Designs/Bracket.sc",
     "dirty": true
    },
    {
     "id": "untitled",
     "name": "Untitled",
     "path": null,
     "dirty": true
    }
   ],
   "steps": [
    {
     "do": "saveSelected"
    },
    {
     "expect": {
      "request": {
       "type": "save",
       "id": "bracket"
      }
     }
    },
    {
     "do": "saveDone"
    },
    {
     "expect": {
      "request": {
       "type": "pick",
       "id": "untitled",
       "why": "never-saved"
      }
     }
    },
    {
     "do": "picked",
     "path": "~/Designs/Clip.sc"
    },
    {
     "expect": {
      "request": {
       "type": "save",
       "id": "untitled",
       "path": "~/Designs/Clip.sc"
      }
     }
    },
    {
     "do": "saveDone"
    },
    {
     "expect": {
      "outcome": "proceeded",
      "saved": {
       "untitled": "~/Designs/Clip.sc"
      },
      "lost": []
     }
    }
   ]
  },
