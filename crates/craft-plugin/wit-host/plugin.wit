package craft:host@0.1.0;

// Read-only negotiation, independent of the command/importer API version. Existing worlds
// and interfaces remain unchanged. A plugin imports this with capability `host@0.1`.
interface capabilities {
    // Only requested capabilities this host supports, required first, then optional, in
    // manifest order and with the requested version spelling. These are not file grants.
    granted: func() -> list<string>;
}

world host-query {
    import capabilities;
}

// Additive import: existing capabilities and plugin worlds remain unchanged.
// Requires host@0.1; a static import requires a host providing this interface.
interface limits {
    record execution-limits {
        // Effective fuel budget after manifest requests and user approval.
        fuel: u64,
        memory-bytes: u64,
        fuel-left: u64,
        // Remaining guest execution time in milliseconds, excluding host calls.
        deadline-ms: u64,
    }
    get: func() -> execution-limits;
}
