;; Original importer component exercising user storage while streaming source into a design.
(component
  (import "craft:plugin/types@0.2.0" (instance $types
    (type $j string)
    (export "json" (type $json (eq $j)))
    (type $c (record (field "command" string) (field "reason" string)))
    (export "command-failure" (type $cf (eq $c)))
    (type $f (record (field "field" string) (field "reason" string)))
    (export "field-failure" (type $ff (eq $f)))
    (type $e (variant
      (case "permission-denied" string) (case "command-failed" $cf)
      (case "limit-exceeded" string) (case "invalid-manifest" $ff)
      (case "invalid-input" $ff) (case "trap" string) (case "cancelled") (case "unsupported" string)))
    (export "plugin-error" (type $error (eq $e)))))
  (alias export $types "json" (type $json))
  (alias export $types "plugin-error" (type $error))
  (type $storage-type (instance
    (alias outer 1 $json (type $j))
    (export "json" (type $j-export (eq $j)))
    (alias outer 1 $error (type $e))
    (export "plugin-error" (type $e-export (eq $e)))
    (type $optional-json (option $j-export))
    (type $get-result (result $optional-json (error $e-export)))
    (type $get (func (param "key" string) (result $get-result)))
    (export "get" (func (type $get)))
    (type $set-result (result (error $e-export)))
    (type $set (func (param "key" string) (param "value" $j-export) (result $set-result)))
    (export "set" (func (type $set)))
    (type $remove-result (result bool (error $e-export)))
    (type $remove (func (param "key" string) (result $remove-result)))
    (export "remove" (func (type $remove)))
    (type $keys (list string))
    (type $list-result (result $keys (error $e-export)))
    (type $list (func (result $list-result)))
    (export "list" (func (type $list)))))
  (import "craft:plugin/user-storage@0.2.0" (instance $storage (type $storage-type)))
  (alias export $storage "get" (func $get))
  (alias export $storage "set" (func $set))
  (alias export $storage "remove" (func $remove))
  (alias export $storage "list" (func $list))
  (type $source-type (instance
    (alias outer 1 $error (type $e))
    (export "plugin-error" (type $e-export (eq $e)))
    (type $file (record (field "name" string) (field "size" u64)))
    (export "file-info" (type $file-info (eq $file)))
    (type $bytes (list u8))
    (type $read-result (result $bytes (error $e-export)))
    (type $read (func (param "path" string) (param "offset" u64) (param "len" u32) (result $read-result)))
    (export "read" (func (type $read)))))
  (import "craft:plugin/source@0.2.0" (instance $source (type $source-type)))
  (alias export $source "read" (func $read))
  (alias export $source "file-info" (type $file-info))
  (type $design-type (instance
    (alias outer 1 $error (type $e))
    (export "plugin-error" (type $e-export (eq $e)))
    (type $bytes (list u8))
    (type $write-result (result (error $e-export)))
    (type $write (func (param "bytes" $bytes) (result $write-result)))
    (export "write" (func (type $write)))))
  (import "craft:plugin/design@0.2.0" (instance $design (type $design-type)))
  (alias export $design "write" (func $write))
  (core module $allocation
    (memory (export "memory") 4)
    (global $heap (mut i32) (i32.const 100000))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $at i32)
      global.get $heap local.tee $at local.get 3 i32.add i32.const 7 i32.add i32.const -8 i32.and global.set $heap local.get $at))
  (core instance $allocation (instantiate $allocation))
  (alias core export $allocation "memory" (core memory $memory))
  (alias core export $allocation "realloc" (core func $realloc))
  (core func $lower-get (canon lower (func $get) (memory $memory) (realloc $realloc)))
  (core func $lower-set (canon lower (func $set) (memory $memory) (realloc $realloc)))
  (core func $lower-remove (canon lower (func $remove) (memory $memory) (realloc $realloc)))
  (core func $lower-list (canon lower (func $list) (memory $memory) (realloc $realloc)))
  (core func $lower-read (canon lower (func $read) (memory $memory) (realloc $realloc)))
  (core func $lower-write (canon lower (func $write) (memory $memory) (realloc $realloc)))
  (core instance $host
    (export "read" (func $lower-read)) (export "write" (func $lower-write))
    (export "memory" (memory $memory))
    (export "get" (func $lower-get)) (export "set" (func $lower-set))
    (export "remove" (func $lower-remove)) (export "list" (func $lower-list)))
  (core module $main
    (import "host" "memory" (memory 4))
    (import "host" "read" (func $read (param i32 i32 i64 i32 i32)))
    (import "host" "write" (func $write (param i32 i32 i32)))
    (import "host" "get" (func $get (param i32 i32 i32)))
    (import "host" "set" (func $set (param i32 i32 i32 i32 i32)))
    (import "host" "remove" (func $remove (param i32 i32 i32)))
    (import "host" "list" (func $list (param i32)))
    (data (i32.const 512) "hinge")
    (data (i32.const 1024) "{\22summary\22:\22Imported\22,\22items\22:[]}")
    (data (i32.const 2048) "42")
    (func (export "execute") (param i32 i32 i32 i32 i64 i32 i32) (result i32)
      __CODE__
      i32.const 0 i32.const 0 i64.const 0 i32.const 65536 i32.const 256 call $read
      i32.const 256 i32.load if i32.const 256 return end
      i32.const 260 i32.load i32.const 264 i32.load i32.const 256 call $write
      i32.const 256 i32.load if i32.const 256 return end
      i32.const 0 i32.const 0 i32.store
      i32.const 4 i32.const 1024 i32.store
      i32.const 8 i32.const 33 i32.store
      i32.const 0))
  (core instance $main (instantiate $main (with "host" (instance $host))))
  (alias core export $main "execute" (core func $execute-core))
  (type $entry-result (result $json (error $error)))
  (type $entry-function (func (param "entry" string) (param "file" $file-info) (param "options" $json) (result $entry-result)))
  (func $execute (type $entry-function)
    (canon lift (core func $execute-core) (memory $memory) (realloc $realloc)))
  (instance $entry
    (export "json" (type $json)) (export "plugin-error" (type $error))
    (export "file-info" (type $file-info)) (export "import-file" (func $execute)))
  (export "craft:plugin/importer@0.2.0" (instance $entry))
)
