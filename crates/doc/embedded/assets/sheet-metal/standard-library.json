{
  "format": "solidcraft-sheet-rules",
  "version": 1,
  "name": "SolidCraft standard materials and gauges",
  "note": "Stock thicknesses with their gauge charts, each material's hardness for the generic K-factor chart, and published minimum inside radii where there are some. The working radius comes from your tooling, and your shop's measured K-factor is better than the chart's estimate.",
  "sources": [
    {
      "id": "msg",
      "title": "Manufacturers' Standard Gauge for sheet steel: thickness = weight (lb/ft²) / 41.82, rounded to 0.0001 in, as published gauge tables list it",
      "url": "https://en.wikipedia.org/wiki/Sheet_metal#Gauge"
    },
    {
      "id": "uss",
      "title": "United States Standard Gauge for sheet and plate iron and steel, 15 U.S.C. 206 (Act of March 3, 1893); stainless sheet is gauged by it",
      "url": "https://www.law.cornell.edu/uscode/text/15/206"
    },
    {
      "id": "awg",
      "title": "Brown & Sharpe (American Wire Gauge), ASTM B258: d = 0.005 in × 92^((36 − n) / 39), rounded to 0.0001 in; the gauge for aluminium, copper and brass sheet",
      "url": "https://en.wikipedia.org/wiki/American_wire_gauge"
    },
    {
      "id": "iso497",
      "title": "Metric thicknesses: the R″10 rounded preferred numbers of ISO 3 and ISO 497 (1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8 per decade), from 0.5 to 6 mm",
      "url": "https://en.wikipedia.org/wiki/Renard_series"
    },
    {
      "id": "kfactor",
      "title": "Hardness for the generic K-factor chart (air bending, bottoming and coining, by inside radius 0 to T, T to 3T and over 3T; soft, medium and hard columns): aluminium is soft, mild steel medium, stainless hard, and copper and brass are read as soft. Reproduced in METU MECH 114, Sheet Metal Work",
      "url": "https://users.metu.edu.tr/sonmez/MECH%20114/Sheet%20Metal%20Work.pdf"
    },
    {
      "id": "al-radii",
      "title": "Approximate minimum radius for 90° cold bend, by alloy, temper and thickness (the chart in Aircraft Spruce's aluminium catalog page): the top of the range for the next listed thickness at or above the sheet's; none where the chart allows a sharp bend",
      "url": "https://www.aircraftspruce.com/pdf/2026Individual/Cat26041.pdf"
    }
  ],
