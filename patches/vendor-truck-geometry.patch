+#[property_test]
+fn test_edge_blend_ders_by_bspline_surface(
+    #[strategy = uniform5(-1.0..=1.0)] z0: [f64; 5],
+    #[strategy = uniform5(0.01..=1.0)] tangent0: [f64; 5],
+    #[strategy = uniform5(-1.0..=1.0)] z1: [f64; 5],
