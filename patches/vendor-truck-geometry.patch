+                -u * f64::cos(v) - (1.0 - u) * f64::sin(v),
+                0.0,
+                u * f64::sin(v) - (1.0 - u) * f64::cos(v),
+            );
+            assert_near!(res_vvder, ans_vvder);
+            let normal = surface.normal(u, v);
+            assert!(normal.dot(res_uder).so_small());
+            assert!(normal.dot(res_vder).so_small());
+        }
+    }
