+        let HomotopySurface {
+            curve0: mut bspcurve0,
+            curve1: mut bspcurve1,
+        } = value;
+        bspcurve0.syncro_degree(&mut bspcurve1);
+        bspcurve0.syncro_knots(&mut bspcurve1);
