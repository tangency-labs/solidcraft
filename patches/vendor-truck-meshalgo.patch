+    }
+    if (cudaMalloc(&d_out_points, out_bytes) != cudaSuccess) {
+        cudaFree(d_u_knots);
+        cudaFree(d_v_knots);
+        cudaFree(d_control_points);
+        cudaFree(d_uv_points);
