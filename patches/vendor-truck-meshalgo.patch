+
+    let trimming_loop_include = calibrate_thresholds(Operation::TrimmingLoopInclude, &trim_samples);
+
+    // ------------------------------------------------------------------------
+    // 6. BsplineEvaluation
+    // ------------------------------------------------------------------------
+    let mut bsp_samples = Vec::new();
