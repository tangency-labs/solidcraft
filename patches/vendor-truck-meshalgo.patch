+    /// Generates a 4-to-1 linearly subdivided mesh on the GPU via CUDA.
+    pub fn linear_subdivide(&self, mesh: &PolygonMesh) -> PolygonMesh {
+        let triangles = super::GpuMeshAnalyzer::extract_triangles(mesh);
+        if triangles.is_empty() {
+            return mesh.clone();
