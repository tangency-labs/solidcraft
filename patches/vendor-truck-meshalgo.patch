+    float3 nor = normalize_safe(cross_product(Su, Sv));
+
+    out_points[idx] = make_float4(pt.x, pt.y, pt.z, 1.0f);
+    out_normals[idx] = make_float4(nor.x, nor.y, nor.z, 0.0f);
+}
