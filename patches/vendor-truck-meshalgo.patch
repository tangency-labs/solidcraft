+    );
+    let vulkan_hit = vulkan.collide_with(&cube0, &cube1);
+    let cuda_hit = cuda.collide_with(&cube0, &cube1);
+    assert_eq!(vulkan_hit.is_some(), cuda_hit.is_some(), "Collision hit presence differs between Vulkan and CUDA!");
+}
