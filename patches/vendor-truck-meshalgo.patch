+    float3 pt = make_float3(0.0f, 0.0f, 0.0f);
+    float3 Su = make_float3(0.0f, 0.0f, 0.0f);
+    float3 Sv = make_float3(0.0f, 0.0f, 0.0f);
+
+    for (int i = 0; i < u_len; ++i) {
+        float nu = Nu[i];
+        float dnu = dNu[i];
+        int ui = u_base + i;
