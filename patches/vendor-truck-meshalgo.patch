+        }
+        let positions = mesh.positions();
+        let flat_triangles: Vec<f64> = tri_faces
+            .iter()
+            .flat_map(|f| {
+                let p0 = positions[f[0].pos];
+                let p1 = positions[f[1].pos];
+                let p2 = positions[f[2].pos];
