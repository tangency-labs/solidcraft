+                #[cfg(feature = "cuda")]
+                return crate::gpu::cuda::CudaMeshAnalyzer::new().collide_with(mesh0, mesh1);
+                #[cfg(not(feature = "cuda"))]
+                mesh0.collide_with(mesh1)
