+        let uniforms = FeatureEdgeUniforms {
+            num_edges,
+            num_faces,
+            cos_crease_angle: crease_angle_rad.cos() as f32,
+            include_creases: 1,
+            include_boundaries: 1,
+            _pad0: 0,
+            _pad1: 0,
+            _pad2: 0,
+        };
+
+        let uniform_buf = BufferHandler::from_slice(
+            &[uniforms],
+            self.handler.device(),
