+    println!("Cache Hit load time           : {:?}", hit_elapsed);
+    assert!(hit_elapsed < std::time::Duration::from_millis(50));
+    assert!(miss_elapsed > hit_elapsed * 10);
+
+    let _ = std::fs::remove_file(&temp_cache_file);
+}
