+__device__ float distance2_point_triangle_baseline(float3 point, float3 v0, float3 v1, float3 v2) {
+    float3 ab = sub(v1, v0);
+    float3 ap = sub(point, v0);
+    float3 bc = sub(v2, v1);
+    float3 bp = sub(point, v1);
+    float3 ca = sub(v0, v2);
+    float3 cp = sub(point, v2);
+    float3 nor = cross_product(ab, ca);
