+                        if (v > 0.0f && (u + v) < 1.0f) {
+                            float t_val = dot_product(tri.nor, rhs) * inv_det;
+                            if (t_val > 0.0f) {
+                                count += (det > 0.0f) ? 1 : -1;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        __syncthreads();
+    }
+
+    if (idx < num_points) {
+        crossing_counts[idx] = count;
+    }
+}
