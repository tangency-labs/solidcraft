+fn exec_ellipse(
+    org_coord: [f64; 3],
+    dir_array: [f64; 2],
+    ref_dir_array: [f64; 2],
+    radius: [f64; 2],
+) {
+    let origin = Point3::from(org_coord);
+    let z = dir_from_array(dir_array);
