+}
+impl_const_step_length!(MatrixAsAxis<Matrix3>, 3);
+
+impl DisplayByStep for MatrixAsAxis<Matrix4> {
+    fn fmt(&self, idx: usize, f: &mut Formatter<'_>) -> Result {
+        let location_idx = idx + 1;
+        let axis_idx = idx + 2;
+        let ref_direction_idx = idx + 3;
