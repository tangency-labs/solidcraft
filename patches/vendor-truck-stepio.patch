+    #[strategy = array::uniform3(-100f64..100.0)] org_coord: [f64; 3],
+    #[strategy = array::uniform2(0.0f64..1.0)] axis_array: [f64; 2],
+) {
+    exec_surface_of_revolution(point0_coord, point1_coord, org_coord, axis_array)
+}
