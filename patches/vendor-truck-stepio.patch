+fn coords_to_points(
+    upoints_len: usize,
+    vpoints_len: usize,
+    coords: Vec<Vec<[f64; 3]>>,
+) -> Vec<Vec<Point3>> {
+    coords
+        .into_iter()
+        .take(upoints_len)
+        .map(move |vec: Vec<[f64; 3]>| {
+            vec.into_iter()
+                .take(vpoints_len)
+                .map(Point3::from)
+                .collect()
+        })
+        .collect()
+}
