+fn interpole_bezier(points: &[Vector4]) -> BSplineCurve<Vector4> {
+    let n = points.len() - 1;
+    let parameter_points = points
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (i as f64 / n as f64, *p))
+        .collect::<Vec<_>>();
+    BSplineCurve::interpole(KnotVec::bezier_knot(n), parameter_points)
+}
