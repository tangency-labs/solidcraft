@@ -201,7 +201,26 @@ where
     fn inverse(&self) -> Self {
         match self {
             Self::FirstType(entity) => Self::FirstType(entity.inverse()),
-            Self::SecondType(entity) => Self::SecondType(entity.inverse()),
+            Self::SecondType(second) => Self::SecondType(second.inverse()),
         }
     }
 }
+
+impl<T: TrySubs, U: TrySubs> TrySubs for Alternative<T, U>
+where
+    Self: ParametricCurve3D,
+{
+    fn try_subs(&self, t: f64) -> Option<Point3> {
+        match self {
+            Self::FirstType(first) => first.try_subs(t),
+            Self::SecondType(second) => second.try_subs(t),
+        }
+    }
+    fn approx_subs(&self, t: f64) -> Point3 {
+        match self {
+            Self::FirstType(first) => first.approx_subs(t),
+            Self::SecondType(second) => second.approx_subs(t),
+        }
+    }
+}
