@@ -64,9 +64,24 @@ impl std::ops::DerefMut for Graph {
 }
 
 impl Graph {
-    fn add_half_edge(&mut self, pt0: Point3, pt1: Point3) {
-        let idx0 = pt0.into();
-        let idx1 = pt1.into();
+    fn find_index(&self, pt: Point3) -> PointIndex {
+        let base: PointIndex = pt.into();
+        for dx in -1..=1 {
+            for dy in -1..=1 {
+                for dz in -1..=1 {
+                    let neighbor = PointIndex([base.0[0] + dx, base.0[1] + dy, base.0[2] + dz]);
+                    if let Some(node) = self.get(&neighbor) {
+                        if node.coord.near(&pt) {
+                            return neighbor;
+                        }
+                    }
+                }
+            }
+        }
+        base
+    }
+
+    fn add_half_edge(&mut self, idx0: PointIndex, pt0: Point3, idx1: PointIndex) {
         if let Some(node) = self.get_mut(&idx0) {
             node.adjacency.insert(idx1);
         } else {
@@ -78,8 +93,12 @@ impl Graph {
 
     fn add_edge(&mut self, line: (Point3, Point3)) {
         if !line.0.near(&line.1) {
-            self.add_half_edge(line.0, line.1);
-            self.add_half_edge(line.1, line.0);
+            let idx0 = self.find_index(line.0);
+            let idx1 = self.find_index(line.1);
+            if idx0 != idx1 {
+                self.add_half_edge(idx0, line.0, idx1);
+                self.add_half_edge(idx1, line.1, idx0);
+            }
         }
     }
 
