+    let total = u2.len().saturating_mul(v2.len());
+    if total <= cap {
+        return (u2, v2);
+    }
+    let f = (total as f64 / cap.max(4) as f64).sqrt();
+    let thin = |d: Vec<f64>| -> Vec<f64> {
+        let n = ((d.len() as f64 / f).ceil() as usize).max(2);
+        if d.len() <= n {
+            return d;
+        }
+        (0..n).map(|i| d[i * (d.len() - 1) / (n - 1)]).collect()
