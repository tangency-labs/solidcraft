+fn balanced_grid(surface: &impl PreMeshableSurface, udiv: Vec<f64>, vdiv: Vec<f64>, cap: usize) -> (Vec<f64>, Vec<f64>) {
+    let mid = |d: &[f64]| if d.is_empty() { 0.0 } else { d[d.len() / 2] };
