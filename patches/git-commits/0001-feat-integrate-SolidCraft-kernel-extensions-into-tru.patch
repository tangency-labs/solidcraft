+    fn old_disjoint(tri0: [Point3; 3], tri1: [Point3; 3]) -> bool {
+        let b0: BoundingBox<Point3> = tri0.iter().collect();
+        let b1: BoundingBox<Point3> = tri1.iter().collect();
+        disjoint_boxes(&b0, &b1)
+    }
