+pub struct MatrixAsAxis<M>(pub M);
+
+impl DisplayByStep for MatrixAsAxis<Matrix3> {
+    fn fmt(&self, idx: usize, f: &mut Formatter<'_>) -> Result {
+        let location_idx = idx + 1;
+        let ref_direction_idx = idx + 2;
