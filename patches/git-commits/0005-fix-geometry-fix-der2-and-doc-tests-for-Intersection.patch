-    /// This method is unimplemented! Should panic!!
     #[inline(always)]
-    fn der2(&self, _: f64) -> Vector3 {
-        unimplemented!();
+    fn der2(&self, t: f64) -> Vector3 {
+        const EPS: f64 = 1.0e-4;
+        let (t0, t1) = match self.parameter_range() {
+            (Bound::Included(a), Bound::Included(b))
+            | (Bound::Included(a), Bound::Excluded(b))
+            | (Bound::Excluded(a), Bound::Included(b))
+            | (Bound::Excluded(a), Bound::Excluded(b)) => (a, b),
+            (Bound::Included(a), Bound::Unbounded)
+            | (Bound::Excluded(a), Bound::Unbounded) => (a, f64::INFINITY),
+            (Bound::Unbounded, Bound::Included(b))
+            | (Bound::Unbounded, Bound::Excluded(b)) => (f64::NEG_INFINITY, b),
+            (Bound::Unbounded, Bound::Unbounded) => (f64::NEG_INFINITY, f64::INFINITY),
+        };
+        if t - EPS < t0 {
+            (self.der(t + EPS) - self.der(t)) / EPS
+        } else if t + EPS > t1 {
+            (self.der(t) - self.der(t - EPS)) / EPS
+        } else {
+            (self.der(t + EPS) - self.der(t - EPS)) / (2.0 * EPS)
+        }
     }
     #[inline(always)]
     fn der_n(&self, n: usize, t: f64) -> Vector3 {
