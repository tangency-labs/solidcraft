  "acceptance": [
    {
      "id": "UI-AC-001",
      "area": "Shell continuity",
      "requirement": "Render uses the existing workspace card, one RENDER tab, shared menus/pins/overflow and shared navigation in both layouts."
    },
    {
      "id": "UI-AC-002",
      "area": "Visual consistency",
      "requirement": "Actual app captures use Tokens and approved SVGs in light, dark, custom and color-vision modes with readable labels/focus."
    },
    {
      "id": "UI-AC-003",
      "area": "Responsive layout",
      "requirement": "At the declared viewports and scales, search, active field, Render/Cancel and close remain reachable without click-through."
    },
    {
      "id": "UI-AC-004",
      "area": "Few-click start",
      "requirement": "A first-time user reaches a supported default still in the target three to five deliberate actions without undocumented expert repair."
    },
    {
      "id": "UI-AC-005",
      "area": "Full-library discovery",
      "requirement": "Filtering and returning to a category preserve query, selection and scroll; concepts and unsupported resources are distinguishable."
    },
    {
      "id": "UI-AC-006",
      "area": "Scoped appearance",
      "requirement": "A supported target scope is explicit, shared-instance effects are explained and appearance changes preserve engineering/physics values."
    },
    {
      "id": "UI-AC-007",
      "area": "Draft and locks",
      "requirement": "Disclosure preserves drafts; preset conflicts resolve before an atomic apply; undo and cancel restore the correct state."
    },
    {
      "id": "UI-AC-008",
      "area": "Request and result",
      "requirement": "Check and Start agree, results belong to their captured document/job, stale output is labeled, and export matches the selected result."
    },
    {
      "id": "UI-AC-009",
      "area": "Accessibility",
      "requirement": "Keyboard and assistive-technology operation cover categories, search, numeric edits, scope, Apply, Render and Cancel without hover-only information."
    },
    {
      "id": "UI-AC-010",
      "area": "SELENE truthfulness",
      "requirement": "Missing improved source and unsupported optics block affected shots; physical lunar scenes never add hidden fill or a historical-source substitute."
    },
    {
      "id": "UI-AC-011",
      "area": "Document isolation",
      "requirement": "Switching documents preserves the right drafts, cameras and jobs; swatches open in a fresh document and preserve the source assembly."
    },
    {
      "id": "UI-AC-012",
      "area": "Runtime evidence",
      "requirement": "Implementation passes relevant repository gates and actual application interaction/visual review; planning JSON or icon previews cannot substitute."
    }
  ],
