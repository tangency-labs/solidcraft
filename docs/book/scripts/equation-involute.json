  {"command": "sketch.equation_curve", "params": {"x": "r * (cos(t) + t * sin(t))", "y": "r * (sin(t) - t * cos(t))", "start": 0, "end": 1.5}},
  {"command": "sketch.circle.center", "params": {"center": [0, 0], "diameter": 40}},
  {"command": "sketch.finish", "params": {}},
  {"command": "view.apply", "params": {"view": "top"}}
]}
