{
  "description": "Issue #3078: a flange on an existing flange's side edge meets a base flange across the bend; the corner relief keeps the flat pattern connected.",
  "commands": [
    {"command": "sheet.manage_rules", "params": {"name": "Sheet 2 mm", "thickness": "2 mm", "k_factor": 0.5, "bend_radius": "1 mm", "gap": "0.5 mm", "active": true}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "Base"}},
    {"command": "sketch.rectangle.two_point", "params": {"p0": [0, 0], "p1": [120, 90]}},
    {"command": "sketch.finish", "params": {}},
    {"command": "sheet.flange", "params": {"sketch": "Base"}},
    {"command": "sheet.flange", "params": {"edges": [[60, 0, 2]], "height": "30 mm", "angle": "90 deg"}},
    {"command": "sheet.flange", "params": {"edges": [[120, 45, 2], [120, 2, 16.5]], "height": "20 mm", "angle": "90 deg", "position": "inside", "corner_relief_shape": "round", "corner_relief": "4 mm"}}
  ]
}
