{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "solidcraft",
    "types": ["bun"],
    "skipLibCheck": true,
    "paths": { "solidcraft": ["./src/index.ts"], "solidcraft/*": ["./src/*"] }
  },
  "include": ["src", "examples", "tests"]
}
