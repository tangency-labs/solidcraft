{
  "name": "solidcraft",
  "version": "0.0.0",
  "description": "SolidCraft from TypeScript: parametric parts as TSX that build real SolidCraft designs (.sc) with editable history",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangency-labs/solidcraft.git",
    "directory": "typescript"
  },
  "homepage": "https://solidcraft.io",
  "bin": {
    "solidcraft-ts": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
