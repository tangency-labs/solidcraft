<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions" revision="1.0" schemaVersion="1.0">
  <displayName>SolidCraft</displayName>
  <description>Settings an organization sets for the people who use SolidCraft on its computers.</description>
  <resources>
    <stringTable>
      <string id="SolidCraft">SolidCraft</string>
      <string id="SUPPORTED_SolidCraft_0_44">SolidCraft 0.44 or later</string>
      <string id="CheckForUpdates">Check for updates</string>
      <string id="CheckForUpdates_Explain">Controls whether SolidCraft asks GitHub for the latest release at start and once a day.

Enabled: SolidCraft checks at start and once a day. People cannot turn the check off.

Disabled: SolidCraft never checks for updates, and Check now is unavailable. Use this when your organization deploys new versions itself.

Not configured: each person chooses in Preferences, General, Updates.

In Preferences the setting shows as set by the organization. The change applies the next time SolidCraft starts.</string>
    </stringTable>
    <presentationTable>
      <presentation id="CheckForUpdates" />
    </presentationTable>
  </resources>
</policyDefinitionResources>
