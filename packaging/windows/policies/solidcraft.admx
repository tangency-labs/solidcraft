          <item displayName="$(string.DefaultUnits_m)">
            <value>
              <string>m</string>
            </value>
          </item>
          <item displayName="$(string.DefaultUnits_in)">
            <value>
              <string>in</string>
            </value>
          </item>
          <item displayName="$(string.DefaultUnits_ft)">
            <value>
