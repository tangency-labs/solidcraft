<?xml version="1.0" encoding="utf-8"?>
<!--
  Group Policy and Intune template for SolidCraft (docs/book/src/guide/managed-deployment.md).
  The app reads these values in crates/ui-egui/src/policy.rs: keep the two in step.
  Intune's import takes no combo boxes and wants every namespace it references uploaded first, so
  this file uses none of either. The target namespace never changes; a new policy raises revision.
-->
<policyDefinitions xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions" revision="1.5" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="solidcraft" namespace="TangencyLabs.Policies.SolidCraft" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_SolidCraft_0_44" displayName="$(string.SUPPORTED_SolidCraft_0_44)" />
      <definition name="SUPPORTED_SolidCraft_0_46" displayName="$(string.SUPPORTED_SolidCraft_0_46)" />
      <definition name="SUPPORTED_SolidCraft_0_48" displayName="$(string.SUPPORTED_SolidCraft_0_48)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="SolidCraft" displayName="$(string.SolidCraft)" />
  </categories>
  <policies>
    <policy name="CheckForUpdates" class="Both" displayName="$(string.CheckForUpdates)" explainText="$(string.CheckForUpdates_Explain)" presentation="$(presentation.CheckForUpdates)" key="Software\Policies\SolidCraft" valueName="CheckForUpdates">
      <parentCategory ref="SolidCraft" />
      <supportedOn ref="SUPPORTED_SolidCraft_0_44" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="UsageStatistics" class="Both" displayName="$(string.UsageStatistics)" explainText="$(string.UsageStatistics_Explain)" presentation="$(presentation.UsageStatistics)" key="Software\Policies\SolidCraft" valueName="UsageStatistics">
      <parentCategory ref="SolidCraft" />
      <supportedOn ref="SUPPORTED_SolidCraft_0_46" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>
    <policy name="OrganizationName" class="Both" displayName="$(string.OrganizationName)" explainText="$(string.OrganizationName_Explain)" presentation="$(presentation.OrganizationName)" key="Software\Policies\SolidCraft">
      <parentCategory ref="SolidCraft" />
      <supportedOn ref="SUPPORTED_SolidCraft_0_44" />
      <elements>
        <text id="OrganizationName" valueName="OrganizationName" maxLength="64" required="true" />
      </elements>
    </policy>
    <policy name="DefaultUnits" class="Both" displayName="$(string.DefaultUnits)" explainText="$(string.DefaultUnits_Explain)" presentation="$(presentation.DefaultUnits)" key="Software\Policies\SolidCraft">
      <parentCategory ref="SolidCraft" />
      <supportedOn ref="SUPPORTED_SolidCraft_0_46" />
      <elements>
        <enum id="DefaultUnits" valueName="DefaultUnits" required="true">
          <item displayName="$(string.DefaultUnits_mm)">
            <value>
              <string>mm</string>
            </value>
          </item>
          <item displayName="$(string.DefaultUnits_cm)">
            <value>
