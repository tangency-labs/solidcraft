<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime only loads libraries signed by our own team. The 3D mouse support
	     (crates/threedx-client/src/macos.rs) dlopens 3Dconnexion's
	     /Library/Frameworks/3DconnexionClient.framework, which is signed by 3Dconnexion. Without
	     this, the load fails and the 3D mouse stops working without any message. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
