{
 "issue": "https://github.com/tangency-labs/solidcraft/issues/679",
 "pr": "https://github.com/tangency-labs/solidcraft/pull/704",
 "test": "crates/kernel/src/issue_679_tests.rs: two_ls_up_and_down_fuse_into_one_solid, several_contact_regions_and_edge_contact",
 "summary": "Bodies that touch back to back over part of a face did not fuse into one solid on SolidCraft's earlier kernel: two L-shaped prisms of a 2 x 2 grid of 10 mm cells, one extruded up from z = 0 and one down, share two whole cells, an edge and a point at z = 0 (#679). The fix's test also fuses a plate under two separate blocks (two contact regions) and a plate under one block, flush with two of its sides. All bodies are planar, so each union is exactly the sum of its operands' volumes; tolerance 1e-6 mm^3 and one solid, as in the test. The test's #674 case (a pad half past a block's edge) is already fixtures/solidcraft/674-partial-face-contact.json; its random-rectangle sweep is not ported.",
 "cases": [
  {
   "name": "two_ls_up_then_down",
   "note": "#679: the L of cells XO/XX extruded up 10 from z = 0 and the L XX/OX down 10, 10 mm cells. They meet back to back over two whole cells, along an edge and at the centre point. Union(up, down).",
   "steps": [
    {
     "op": "extrude",
     "id": "up",
     "profile": [
      {
       "kind": "polygon",
       "points": [
        [
         -10,
         -10
        ],
        [
         10,
         -10
        ],
        [
         10,
         0
        ],
        [
         0,
         0
        ],
        [
         0,
         10
        ],
        [
         -10,
         10
        ]
       ]
      }
     ],
     "origin": [
      0,
      0,
      0
     ],
     "distance": 10
    },
    {
     "op": "extrude",
     "id": "down",
     "profile": [
      {
       "kind": "polygon",
       "points": [
        [
         -10,
         10
        ],
        [
         -10,
         0
        ],
        [
         0,
         0
        ],
        [
         0,
         -10
        ],
        [
         10,
         -10
        ],
        [
         10,
         10
        ]
       ]
      }
     ],
     "origin": [
      0,
      0,
      -10
     ],
     "distance": 10
    },
    {
     "op": "union",
     "id": "result",
     "a": "up",
     "b": "down"
    }
   ],
   "expect": {
    "lumps": 1,
    "volume": {
     "value": 6000.0,
     "tol": 1e-06,
     "formula": "6 cells of 10 x 10 x 10 mm (3 up, 3 down; the two prisms only touch, at z = 0)"
    }
   }
  },
